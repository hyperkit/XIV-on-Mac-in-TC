+// DXMT_NVNGX_RENDER_SCALE overrides the render scale returned for every quality mode (0.33 - 1.0).
+// Games that size their dynamic resolution from the optimal settings (e.g. FFXIV) follow it.
+static float
+GetRenderScaleOverride() {
+  static const float scale = [] {
+    auto value = env::getEnvVar("DXMT_NVNGX_RENDER_SCALE");
+    if (value.empty())
+      return 0.0f;
+    float parsed = std::strtof(value.c_str(), nullptr);
+    if (!(parsed >= 0.33f && parsed <= 1.0f)) {
+      WARN("DXMT_NVNGX_RENDER_SCALE=", value, " ignored, expected 0.33 - 1.0");
+      return 0.0f;
+    }
+    // the MetalFX temporal scaler is created with a maximum input content scale of 3
+    parsed = std::max(parsed, 1.0f / 3.0f);
+    Logger::info(str::format("DXMT_NVNGX_RENDER_SCALE=", parsed));
+    return parsed;
+  }();
+  return scale;
+}
